APP_NAME=LshopBridge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=2.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Real-time notifications (Laravel Reverb). Generate real values with
# `php artisan reverb:install` — never reuse these placeholders.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#--------------------------------------------------------------------------
# Auth & security integrations, env-only by design, never admin-editable.
#--------------------------------------------------------------------------
# Google sign-in (console.cloud.google.com → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile bot-protection (dash.cloudflare.com → Turnstile).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare account API token (dash.cloudflare.com → My Profile → API Tokens).
# Not yet wired to any feature in this codebase.
CLOUDFLARE_API_TOKEN=

# SMS provider. Only "twilio" is actually wired to a sender; set SMS_PROVIDER=twilio
# with your Twilio credentials to send real SMS security alerts. Anything else
# (including blank) is a documented no-op — nothing is silently faked.
SMS_PROVIDER=
SMS_ACCOUNT_SID=
SMS_API_KEY=
SMS_SENDER=

# Ops-facing critical security alerts (audit-log tamper detection, etc).
# Create an "Incoming Webhook" in Discord/Slack and paste the URL here.
# Blank = no-op, nothing is sent.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Geo-IP lookup for new-country login detection (ipinfo.io — free tier
# available, https://ipinfo.io/signup). Blank = no-op: no location data is
# guessed or fabricated, matching this app's existing honesty rule about not
# faking things it can't actually check.
IPINFO_API_KEY=

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# LshopBridge platform settings
#--------------------------------------------------------------------------
PAYMENTS_AUTOMATION_ENABLED=true
FUNDING_AUTOMATION_ENABLED=true
PROVIDER_MODE=sandbox

# Optional: pin the password DemoUserSeeder assigns to demo accounts (superadmin,
# admin, kofi@example.com, agent@example.com). Leave unset to get a fresh random
# password printed to the console on every `migrate:fresh --seed`.
# DEMO_PASSWORD=

# MTN MoMo
MTN_MOMO_MODE=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_WEBHOOK_SECRET=

# Orange Money
ORANGE_MONEY_MODE=sandbox
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=

# Flutterwave
FLUTTERWAVE_MODE=sandbox
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Crypto gateway
CRYPTO_GATEWAY_MODE=sandbox
CRYPTO_GATEWAY_BASE_URL=
CRYPTO_GATEWAY_API_KEY=
CRYPTO_GATEWAY_WEBHOOK_SECRET=

# Card gateway
CARD_GATEWAY_MODE=sandbox
CARD_GATEWAY_BASE_URL=
CARD_GATEWAY_API_KEY=
CARD_GATEWAY_WEBHOOK_SECRET=

# Alipay / China funding provider
ALIPAY_FUNDING_MODE=sandbox
ALIPAY_FUNDING_BASE_URL=
ALIPAY_FUNDING_PARTNER_ID=
ALIPAY_FUNDING_API_KEY=
ALIPAY_FUNDING_API_SECRET=
ALIPAY_FUNDING_WEBHOOK_SECRET=
